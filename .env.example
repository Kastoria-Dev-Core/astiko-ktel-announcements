# Upstash Redis (Vercel dashboard -> Storage -> Create Database -> Upstash Redis)
# Auto-added to the Vercel project's env vars when you connect the store
# (as KV_REST_API_URL / KV_REST_API_TOKEN; the UPSTASH_ names also work).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Any random string. Vercel sends it to the cron automatically; requests to
# /api/refresh-announcements without it are rejected.
CRON_SECRET=

# Optional
# ANNOUNCEMENTS_LIMIT=30
# SOURCE_SITE=https://astikoktelkastorias.gr
